{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "allowJs": true,
    "jsx": "react",
    "strict": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "esModuleInterop": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "rootDir": "src/",
    "outDir": "dist/",
    "paths": {
      "@ns": ["./NetscriptDefinitions.d.ts"],
      "/*": ["./src/*"],
      "*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*",
    "NetscriptDefinitions.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/lib/react.ts"
  ]
}